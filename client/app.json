      "package": "com.ecopy.admin",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "93fdc4c9-d8ef-4685-a6a1-4df16d2ddac7"
      }
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
